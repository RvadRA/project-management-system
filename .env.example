

# ── Сервер ──────────────────────────────────────────────────────────────────
# True — только на машине разработчика. На боевом сервере False (или не задавать).
DJANGO_DEBUG=False
# Сгенерировать: python manage.py generate_secret_key
DJANGO_SECRET_KEY=
# Домены, по которым открывается сервер, через запятую
DJANGO_ALLOWED_HOSTS=pms.example.com
# Адреса интерфейса, которым разрешено обращаться к API
CORS_ALLOWED_ORIGINS=https://pms.example.com
CSRF_TRUSTED_ORIGINS=https://pms.example.com
# Если сервер временно работает без HTTPS — False (не рекомендуется)
DJANGO_USE_HTTPS=True

# ── База данных ─────────────────────────────────────────────────────────────
DB_NAME=pms_db
DB_USER=pms_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Ограничения ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
LOGIN_THROTTLE_PER_IP=20/min
LOGIN_THROTTLE_PER_USER=8/min
# Хосты внутренней сети, к которым можно обращаться задачам-интеграциям (по умолчанию запрещено)
INTEGRATION_ALLOWED_HOSTS=

# ── ИИ-ассистент ────────────────────────────────────────────────────────────
# Ассистент использует только локальную Ollama. Внешние API и ключи не нужны.

# ── Уведомления ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
SLACK_WEBHOOK_URL=
FRONTEND_URL=http://localhost:5173
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=90
# Бюджеты интерактивного подбора Top-3: при превышении используется детерминированный подбор.
OLLAMA_ANALYSIS_TIMEOUT=20
OLLAMA_EXPLANATION_TIMEOUT=5
# Локальная модель — единственный провайдер ассистента.
OLLAMA_CHAT_TIMEOUT=20
# Одна безопасная повторная попытка при временном таймауте/обрыве связи.
OLLAMA_CHAT_RETRIES=1
OLLAMA_RETRY_BACKOFF=1
OLLAMA_STATUS_TIMEOUT=2
OLLAMA_NUM_CTX=4096
# 0 = выгрузить чат-модель после ответа (экономия RAM, следующий запрос медленнее).
# Для более быстрых повторных запросов можно указать 5m.
OLLAMA_KEEP_ALIVE=0
